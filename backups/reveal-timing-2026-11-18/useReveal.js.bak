import { useLayoutEffect, useRef } from 'react'
import { whenRevealed } from './revealScheduler'

// Scroll reveal for a section: its blades wipe in left to right, and the
// About highlight sweeps in, once each -- when revealScheduler says so (the
// section properly on screen, then each element at its own position).
// CSS: .blade.rv-wait / .is-in and .s-highlight.is-in in index.css; the
// stagger delay is set per blade in --d. No flips, no sound.
//
// Only what is in the section when it mounts waits for its turn; content
// that appears later (a project panel the visitor opens) shows as it is.
// Reduced motion: everything is shown at once.
export function useReveal() {
  const ref = useRef(null)
  // before the first paint, so nothing flashes in and back out
  useLayoutEffect(() => {
    const section = ref.current
    if (!section) return undefined
    const offs = []
    section.querySelectorAll('.blade').forEach((blade) => {
      blade.classList.add('rv-wait')
      offs.push(whenRevealed(blade, (delay) => {
        blade.style.setProperty('--d', `${delay}ms`)
        blade.classList.add('is-in')
      }, section))
    })
    section.querySelectorAll('.s-highlight').forEach((hl) => {
      offs.push(whenRevealed(hl, (delay) => { setTimeout(() => hl.classList.add('is-in'), delay) }, section))
    })
    return () => offs.forEach((off) => off())
  }, [])
  return ref
}
